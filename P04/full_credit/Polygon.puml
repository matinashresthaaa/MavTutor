@startuml
set separator none
skinparam classAttributeIconSize 0
hide circle

class Polygon{
    +MAX_SIDES : int <<final>>
    -numSides : int
    -points : Point[]
    +addPoint(point : Point)
    +perimeter() : double
    +toString() : String <<override>>
    -lineLength(p1 : Point, p2 : Point) : double
}

class Point{
    -x : double
    -y :double
    +Point(x : double, y : double)
    +Point()
    +getX() : double
    +getY() : double
    +hashCode() : int <<override>>
    +toString() : String <<override>>
}

class TestPolygon{
    -in : Scanner
    -rand :Random <<optional>>
    +main(args : String[])
}


@enduml